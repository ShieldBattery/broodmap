{
  "name": "broodmap-wasm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WebAssembly bindings for rendering StarCraft: Brood War map previews",
  "scripts": {
    "build": "pnpm run build:web && pnpm run build:node",
    "build:web": "wasm-pack build --target web",
    "build:node": "wasm-pack build --target nodejs --out-dir pkg-node",
    "assets:analysis": "cargo run --release -p broodmap-cli -- fetch-assets --analysis-only --out examples/assets",
    "assets": "cargo run --release -p broodmap-cli -- fetch-assets --out examples/assets",
    "dev": "pnpm run build:web && vite",
    "build:demo": "pnpm run build:web && vite build",
    "test": "node --test examples/*.test.mjs tests/topology-reference/*.test.mjs"
  },
  "license": "MIT OR Apache-2.0",
  "devDependencies": {
    "vite": "^7.1.5"
  }
}
